---
interface Props {
  text?: string;
  href?: string;
  clipboardCopy?: string;
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const {
  text = '',
  href,
  clipboardCopy,
  size = 'md',
  className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-[4.8rem] h-[4.8rem] text-[1.4rem]',
  md: 'w-[6.4rem] h-[6.4rem] text-[1.6rem]',
  lg: 'w-[8rem] h-[8rem] text-[2rem]',
}[size];
---

{
  href ? (
    <a
      href={href}
      data-cursor="-pointer"
      class={`round-button group relative inline-flex items-center justify-center rounded-full bg-white/10 border border-white/20 text-white font-medium hover:border-white/50 spring-btn ${sizeClasses} ${className}`}
    >
      <span class="relative z-10">
        <slot>{text}</slot>
      </span>
      <div class="absolute inset-0 rounded-full bg-white/20 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out" />
    </a>
  ) : (
    <button
      type="button"
      data-clipboard-copy={clipboardCopy}
      data-cursor="-pointer"
      class={`round-button group relative inline-flex items-center justify-center rounded-full bg-white/10 border border-white/20 text-white font-medium hover:border-white/50 spring-btn ${sizeClasses} ${className}`}
    >
      <span class="btn-text relative z-10 transition-opacity duration-200">
        <slot>{text}</slot>
      </span>
      <span class="copied-badge absolute z-10 text-[1.2rem] text-emerald-400 font-semibold opacity-0 scale-75 transition-all duration-200 pointer-events-none">
        Copied!
      </span>
      <div class="absolute inset-0 rounded-full bg-white/20 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out" />
    </button>
  )
}

<script>
  function initClipboardButtons() {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-clipboard-copy]');
    copyButtons.forEach((btn) => {
      const textToCopy = btn.getAttribute('data-clipboard-copy');
      if (!textToCopy) return;

      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(textToCopy);
          const textEl = btn.querySelector('.btn-text');
          const badgeEl = btn.querySelector('.copied-badge');

          if (textEl && badgeEl) {
            textEl.classList.add('opacity-0');
            badgeEl.classList.remove('opacity-0', 'scale-75');
            badgeEl.classList.add('opacity-100', 'scale-100');

            setTimeout(() => {
              textEl.classList.remove('opacity-0');
              badgeEl.classList.add('opacity-0', 'scale-75');
              badgeEl.classList.remove('opacity-100', 'scale-100');
            }, 1800);
          }
        } catch (err) {
          console.error('Failed to copy to clipboard', err);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initClipboardButtons);
  initClipboardButtons();
</script>
