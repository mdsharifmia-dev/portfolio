    // --- UNIVERSAL VOICE RECORDING & LIVE INPUT TYPING ---
    // User instruction:
    // 1. Do NOT auto-send message when voice recording stops.
    // 2. Transcribe voice accurately (both Bengali and English) and insert directly into input field so user can edit with keyboard.
    // 3. Keep listening continuously until user clicks mic again to stop.
    // 4. Strict Zero-Emoji compliance.
    let isRecording = false;
    let audioStream = null;
    let audioContext = null;
    let scriptProcessor = null;
    let micSource = null;
    let pcmBuffers = [];

    const SVG_MIC = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line><line x1="8" y1="22" x2="16" y2="22"></line></svg>';
    const SVG_STOP = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"></rect></svg>';

    function encodeWav(samples, sampleRate) {
      const buffer = new ArrayBuffer(44 + samples.length * 2);
      const view = new DataView(buffer);
      function writeStr(offset, str) {
        for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
      }
      writeStr(0, 'RIFF');
      view.setUint32(4, 36 + samples.length * 2, true);
      writeStr(8, 'WAVE');
      writeStr(12, 'fmt ');
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true); // PCM
      view.setUint16(22, 1, true); // Mono
      view.setUint32(24, sampleRate, true);
      view.setUint32(28, sampleRate * 2, true);
      view.setUint16(32, 2, true);
      view.setUint16(34, 16, true);
      writeStr(36, 'data');
      view.setUint32(40, samples.length * 2, true);

      let offset = 44;
      for (let i = 0; i < samples.length; i++, offset += 2) {
        const s = Math.max(-1, Math.min(1, samples[i]));
        view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
      }
      return new Blob([buffer], { type: 'audio/wav' });
    }

    function downsampleBuffer(buffer, inputSampleRate, targetSampleRate = 16000) {
      if (inputSampleRate === targetSampleRate) return buffer;
      const ratio = inputSampleRate / targetSampleRate;
      const newLength = Math.round(buffer.length / ratio);
      const result = new Float32Array(newLength);
      let offsetResult = 0;
      let offsetBuffer = 0;
      while (offsetResult < result.length) {
        const nextOffsetBuffer = Math.round((offsetResult + 1) * ratio);
        let accum = 0, count = 0;
        for (let i = offsetBuffer; i < nextOffsetBuffer && i < buffer.length; i++) {
          accum += buffer[i];
          count++;
        }
        result[offsetResult] = count > 0 ? accum / count : 0;
        offsetResult++;
        offsetBuffer = nextOffsetBuffer;
      }
      return result;
    }

    async function toggleVoiceRecording() {
      if (isRecording) {
        stopVoiceRecording();
      } else {
        startVoiceRecording();
      }
    }

    async function startVoiceRecording() {
      if (isRecording) return;
      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          alert('আপনার ব্রাউজারে মাইক্রোফোন সাপোর্ট নেই।');
          return;
        }

        audioStream = await navigator.mediaDevices.getUserMedia({
          audio: {
            channelCount: 1,
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true
          }
        });

        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) {
          alert('AudioContext সাপোর্ট নেই।');
          return;
        }

        audioContext = new AudioCtx();
        micSource = audioContext.createMediaStreamSource(audioStream);
        scriptProcessor = audioContext.createScriptProcessor(4096, 1, 1);
        pcmBuffers = [];

        scriptProcessor.onaudioprocess = (e) => {
          if (!isRecording) return;
          const channel = e.inputBuffer.getChannelData(0);
          pcmBuffers.push(new Float32Array(channel));
        };

        micSource.connect(scriptProcessor);
        scriptProcessor.connect(audioContext.destination);

        isRecording = true;
        if (voiceBtn) voiceBtn.classList.add('-listening');
        if (voiceIcon) voiceIcon.innerHTML = SVG_STOP;
        if (input) input.placeholder = 'শুনছি... কথা বলুন (থামাতে মাইকে আবার ক্লিক করুন)';
      } catch (err) {
        console.error('Microphone error:', err);
        alert('মাইক্রোফোন অ্যাক্সেস করতে অনুমতি দেওয়া হয়নি বা কোনো ত্রুটি হয়েছে।');
      }
    }

    async function stopVoiceRecording() {
      if (!isRecording) return;
      isRecording = false;

      if (voiceBtn) voiceBtn.classList.remove('-listening');
      if (voiceIcon) voiceIcon.innerHTML = SVG_MIC;
      if (input) input.placeholder = 'কথা প্রসেস হচ্ছে... অনুগ্রহ করে অপেক্ষা করুন...';

      if (scriptProcessor) {
        try {
          scriptProcessor.disconnect();
          scriptProcessor.onaudioprocess = null;
        } catch(e){}
        scriptProcessor = null;
      }

      if (micSource) {
        try { micSource.disconnect(); } catch(e){}
        micSource = null;
      }

      const capturedSampleRate = audioContext ? audioContext.sampleRate : 44100;
      if (audioContext && audioContext.state !== 'closed') {
        try { audioContext.close(); } catch(e){}
        audioContext = null;
      }

      if (audioStream) {
        audioStream.getTracks().forEach(t => t.stop());
        audioStream = null;
      }

      if (pcmBuffers.length === 0) {
        if (input) input.placeholder = 'যেকোনো ভাষায় লিখুন বা মাইকে ক্লিক করে কথা বলুন...';
        return;
      }

      let totalSamples = 0;
      for (let i = 0; i < pcmBuffers.length; i++) totalSamples += pcmBuffers[i].length;
      const fullBuffer = new Float32Array(totalSamples);
      let offset = 0;
      for (let i = 0; i < pcmBuffers.length; i++) {
        fullBuffer.set(pcmBuffers[i], offset);
        offset += pcmBuffers[i].length;
      }
      pcmBuffers = [];

      const downsampled = downsampleBuffer(fullBuffer, capturedSampleRate, 16000);
      const wavBlob = encodeWav(downsampled, 16000);

      // Transcribe via backend agent server
      const host = window.location.hostname || '127.0.0.1';
      const endpoints = [
        `http://${host}:4322/transcribe`,
        `http://127.0.0.1:4322/transcribe`
      ];

      let recognizedText = '';
      for (const ep of endpoints) {
        try {
          const res = await fetch(ep, {
            method: 'POST',
            body: wavBlob
          });
          if (res.ok) {
            const data = await res.json();
            if (data.text && data.text.trim()) {
              recognizedText = data.text.trim();
              break;
            }
          }
        } catch (err) {
          console.warn(`STT endpoint ${ep} note:`, err);
        }
      }

      if (recognizedText) {
        // User requested: Put directly into input box so user can edit via keyboard, DO NOT auto-send!
        if (input) {
          input.value = (input.value ? input.value.trim() + ' ' : '') + recognizedText;
