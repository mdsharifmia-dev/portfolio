---
import type { ProjectItem } from '../types/portfolio';

interface Props {
  project: ProjectItem;
  index: number;
}

const { project, index } = Astro.props;
---

<div
  class="project-card group relative bg-white/[0.03] border border-white/10 rounded-3xl p-8 md:p-12 transition-all duration-300 hover:border-white/30 hover:bg-white/[0.05]"
  data-cursor-text="Inspect"
>
  <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-emerald-400 font-mono text-[1.2rem] font-semibold">0{index + 1}</span>
        <span class="text-white/40 text-[1.2rem]">•</span>
        <span class="text-white/60 text-[1.3rem] font-medium uppercase tracking-wider">{project.category}</span>
        <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-[1.1rem] font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          {project.status}
        </span>
      </div>
      <h3 class="text-white text-[2.6rem] md:text-[3.4rem] font-bold tracking-tight">
        {project.title}
      </h3>
    </div>

    <!-- Impact Metric Pill -->
    {project.impactMetric && (
      <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-2xl px-5 py-3 md:text-right shrink-0">
        <div class="text-[1.1rem] text-emerald-400/80 uppercase font-semibold tracking-wider">
          {project.impactMetric.label}
        </div>
        <div class="text-[1.4rem] font-semibold text-white mt-0.5">
          {project.impactMetric.value}
        </div>
      </div>
    )}
  </div>

  <p class="text-white/70 text-[1.6rem] leading-relaxed mb-8">
    {project.summary}
  </p>

  <!-- Problem & Solution Box -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-black/30 border border-white/5 rounded-2xl p-6 mb-8">
    <div>
      <div class="text-[1.2rem] text-red-400 font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400" />
        Business Bottleneck
      </div>
      <p class="text-white/60 text-[1.35rem] leading-relaxed">
        {project.problem}
      </p>
    </div>
    <div>
      <div class="text-[1.2rem] text-emerald-400 font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" />
        Implemented Solution
      </div>
      <p class="text-white/60 text-[1.35rem] leading-relaxed">
        {project.solution}
      </p>
    </div>
  </div>

  <!-- Tech Stack & Links Footer -->
  <div class="flex flex-wrap items-center justify-between gap-6 pt-6 border-t border-white/10">
    <div class="flex flex-wrap items-center gap-2.5">
      {project.techStack.map((tech) => (
        <span class="bg-white/[0.06] border border-white/10 text-white/80 text-[1.2rem] font-medium px-3.5 py-1 rounded-full">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-4">
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 hover:text-white text-[1.3rem] font-medium flex items-center gap-1.5 transition-colors rolling-text"
          data-cursor="-pointer"
        >
          <span data-text="GitHub Repo →">GitHub Repo →</span>
        </a>
      )}
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-black text-[1.3rem] font-semibold px-5 py-2.5 rounded-full hover:bg-emerald-400 transition-colors spring-btn"
          data-cursor="-pointer"
        >
          <span class="rolling-text">
            <span data-text="Live Demo ↗">Live Demo ↗</span>
          </span>
        </a>
      )}
    </div>
  </div>
</div>
