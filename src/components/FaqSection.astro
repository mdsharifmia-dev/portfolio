---
import { portfolioData } from '../data/portfolioData';

const { faq } = portfolioData;
---

<section id="faq" class="py-[12rem] px-8 md:px-16 relative">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16 text-center">
      <div class="text-emerald-400 font-mono text-[1.4rem] font-semibold tracking-wider uppercase mb-3">
        // Clarifications
      </div>
      <h2 class="text-white text-[3.8rem] md:text-[5.4rem] font-bold tracking-tight mb-4">
        Frequently Asked Questions
      </h2>
      <p class="text-white/60 text-[1.8rem] max-w-xl mx-auto">
        Practical information on collaboration, communication, and engineering workflow.
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="flex flex-col gap-4">
      {faq.map((item, idx) => (
        <details class="faq-item group bg-white/[0.03] border border-white/10 rounded-2xl overflow-hidden transition-colors hover:border-white/25">
          <summary class="flex items-center justify-between p-7 cursor-pointer list-none select-none text-white text-[1.8rem] md:text-[2rem] font-semibold" data-cursor="-pointer">
            <span>{item.question}</span>
            <span class="faq-icon text-[2rem] text-emerald-400 transition-transform duration-300 group-open:rotate-45 font-mono">
              +
            </span>
          </summary>
          <div class="px-7 pb-7 pt-2 text-white/70 text-[1.55rem] leading-relaxed border-t border-white/5">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
