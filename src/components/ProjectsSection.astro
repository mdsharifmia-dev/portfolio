---
import { portfolioData } from '../data/portfolioData';
import ProjectCard from './ProjectCard.astro';

const { projects } = portfolioData;
---

<section id="projects" class="py-[12rem] px-8 md:px-16 relative">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="text-emerald-400 font-mono text-[1.4rem] font-semibold tracking-wider uppercase mb-3">
          // Selected Case Studies
        </div>
        <h2 class="text-white text-[3.8rem] md:text-[5.4rem] font-bold tracking-tight">
          Featured Engineering Work
        </h2>
      </div>
      <p class="text-white/60 text-[1.6rem] max-w-md">
        Verified real-world systems spanning LLM agent architectures, custom workflow bots, and full-stack software.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="flex flex-col gap-10">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </div>
</section>
