---
import { portfolioData } from '../data/portfolioData';

const { skillCategories } = portfolioData;
---

<section id="skills" class="py-[12rem] px-8 md:px-16 bg-white/[0.015] border-y border-white/5 relative">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16">
      <div class="text-emerald-400 font-mono text-[1.4rem] font-semibold tracking-wider uppercase mb-3">
        // Technical Foundation
      </div>
      <h2 class="text-white text-[3.8rem] md:text-[5.4rem] font-bold tracking-tight mb-4">
        Skills & Production Tools
      </h2>
      <p class="text-white/60 text-[1.8rem] max-w-2xl">
        Technologies I utilize daily to architect, implement, and deploy automated systems and web products.
      </p>
    </div>

    <!-- 4 Categorical Columns -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {skillCategories.map((cat) => (
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7 hover:border-white/20 transition-colors">
          <h3 class="text-white text-[1.8rem] font-bold tracking-tight mb-6 pb-3 border-b border-white/10">
            {cat.categoryName}
          </h3>
          <ul class="flex flex-col gap-3.5">
            {cat.skills.map((skill) => (
              <li class="flex items-center gap-2.5 text-white/70 text-[1.4rem]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" />
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
