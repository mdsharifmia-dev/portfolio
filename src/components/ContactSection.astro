---
import { portfolioData } from '../data/portfolioData';
import RoundButton from './RoundButton.astro';

const { personalInfo } = portfolioData;
const whatsappLink = `https://wa.me/${personalInfo.whatsappNumber}?text=${encodeURIComponent(personalInfo.whatsappPresetMessage)}`;
---

<section id="contact" class="py-[14rem] px-8 md:px-16 bg-white/[0.02] border-t border-white/10 relative overflow-hidden">
  <!-- Glow Backdrop -->
  <div class="absolute bottom-0 right-1/4 w-[50rem] h-[50rem] bg-emerald-500/10 rounded-full blur-[14rem] pointer-events-none" />

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 relative z-10">
    <!-- Left Column: Direct Links & Info -->
    <div>
      <div class="text-emerald-400 font-mono text-[1.4rem] font-semibold tracking-wider uppercase mb-3">
        // Direct Communication
      </div>
      <h2 class="text-white text-[4rem] sm:text-[5.4rem] md:text-[6.4rem] font-bold tracking-tight leading-[1.05] mb-6">
        Let’s Build Something Dependable.
      </h2>
      <p class="text-white/70 text-[1.8rem] leading-relaxed mb-10 max-w-lg">
        Have an automation need, AI agent project, or web application to build? Drop a direct message or copy my verified email below.
      </p>

      <!-- Quick Action Cards -->
      <div class="flex flex-col gap-4 max-w-md">
        <!-- Email Copy Row -->
        <div class="flex items-center justify-between p-5 bg-white/[0.04] border border-white/10 rounded-2xl">
          <div>
            <div class="text-[1.2rem] text-white/50 uppercase tracking-wider mb-1 font-mono">Email Address</div>
            <div class="text-[1.6rem] text-white font-medium">{personalInfo.email}</div>
          </div>
          <RoundButton clipboardCopy={personalInfo.email} size="sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </RoundButton>
        </div>

        <!-- WhatsApp Direct Route -->
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="-pointer"
          class="flex items-center justify-between p-5 bg-emerald-500/10 border border-emerald-500/25 rounded-2xl hover:bg-emerald-500/20 transition-colors spring-btn"
        >
          <div>
            <div class="text-[1.2rem] text-emerald-400 uppercase tracking-wider mb-1 font-mono">Instant Chat</div>
            <div class="text-[1.6rem] text-white font-semibold">Message on WhatsApp →</div>
          </div>
          <span class="text-emerald-400">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Right Column: Interactive Contact Form -->
    <div class="bg-white/[0.03] border border-white/10 rounded-3xl p-8 md:p-12">
      <h3 class="text-white text-[2.4rem] font-bold mb-6">Send an Inquiry</h3>
      <form class="flex flex-col gap-6" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent to Sharif.');">
        <div>
          <label class="block text-white/60 text-[1.3rem] font-medium uppercase tracking-wider mb-2">Your Name</label>
          <input
            type="text"
            required
            placeholder="John Doe"
            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white text-[1.5rem] focus:outline-none focus:border-emerald-400 transition-colors"
          />
        </div>

        <div>
          <label class="block text-white/60 text-[1.3rem] font-medium uppercase tracking-wider mb-2">Your Email</label>
          <input
            type="email"
            required
            placeholder="john@example.com"
            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white text-[1.5rem] focus:outline-none focus:border-emerald-400 transition-colors"
          />
        </div>

        <div>
          <label class="block text-white/60 text-[1.3rem] font-medium uppercase tracking-wider mb-2">Project Overview</label>
          <textarea
            rows="4"
            required
            placeholder="Tell me about your project, timeline, and expectations..."
            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white text-[1.5rem] focus:outline-none focus:border-emerald-400 transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          data-cursor="-pointer"
          class="w-full bg-white text-black text-[1.6rem] font-bold py-5 rounded-xl hover:bg-emerald-400 transition-colors spring-btn"
        >
          <span class="rolling-text">
            <span data-text="Send Message →">Send Message →</span>
          </span>
        </button>
      </form>
    </div>
  </div>
</section>
